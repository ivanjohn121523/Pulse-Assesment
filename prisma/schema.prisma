// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id        String   @id // public session uuid — visible to other dots
  secret    String   @default("") // private; required to poll, signal, or leave
  name      String // display name chosen before entering the map
  gender    String   @default("") // "male" | "female"; removed with the session
  lat       Float // ALREADY privacy-offset coords (raw is never stored)
  lng       Float
  busy      Boolean  @default(false) // true while in an active connection
  partnerId String? // the other session in that connection
  lastSeen  DateTime

  @@index([lastSeen])
}

model Knock {
  // A connection request that has not been accepted or declined yet.
  // Kept separate from Signal so draining a mailbox cannot forge an accept.
  id        String   @id @default(uuid())
  toId      String
  fromId    String
  createdAt DateTime @default(now())

  @@unique([toId, fromId])
  @@index([toId])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}
